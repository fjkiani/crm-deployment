# =============================================================================
# Dockerfile.frappe
#
# Pulls the pre-built image from GHCR and overrides the entrypoint.
# The actual build happens in GitHub Actions (.github/workflows/build-frappe.yml).
# =============================================================================

FROM ghcr.io/fjkiani/crm-frappe:main

# Override entrypoint to skip asset linking (not needed for API-only mode)
# and run init-site.sh directly
ENTRYPOINT []
CMD ["/home/frappe/init-site.sh"]
