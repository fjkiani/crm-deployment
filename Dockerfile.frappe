# =============================================================================
# Dockerfile.frappe
# Frappe (develop branch) + CRM app — self-hosted, platform-agnostic
#
# Uses python:3.11 (full Debian Bookworm) — has all build tools pre-installed.
# Installs nodejs from Debian repos (no nodesource curl|bash needed).
#
# One image, four roles (set via `command:` in docker-compose):
#   frappe-web       → /home/frappe/init-site.sh  (default)
#   frappe-worker    → bench worker --queue long,default,short
#   frappe-scheduler → bench schedule
#   frappe-socketio  → node apps/frappe/socketio.js
# =============================================================================

FROM python:3.11

# ---------------------------------------------------------------------------
# System dependencies
# nodejs is available directly in Debian Bookworm repos (no nodesource needed)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    default-libmysqlclient-dev \
    mariadb-client \
    git \
    redis-tools \
    gettext \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    libpng-dev \
    && npm install -g yarn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Non-root user (Frappe convention)
# ---------------------------------------------------------------------------
RUN useradd -ms /bin/bash frappe
WORKDIR /home/frappe

# ---------------------------------------------------------------------------
# Install frappe-bench CLI
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir frappe-bench

# ---------------------------------------------------------------------------
# Initialise bench with Frappe framework (develop branch HEAD)
# --skip-assets: no DB available at build time
# ---------------------------------------------------------------------------
USER frappe
RUN bench init \
    --frappe-branch develop \
    --frappe-path https://github.com/frappe/frappe \
    --skip-assets \
    --python python3 \
    frappe-bench

WORKDIR /home/frappe/frappe-bench

# ---------------------------------------------------------------------------
# Install frappe-mcp (PyPI v0.1.0)
# ---------------------------------------------------------------------------
RUN ./env/bin/pip install --no-cache-dir frappe-mcp==0.1.0

# ---------------------------------------------------------------------------
# Copy CRM app source into the bench (from this repo's crm/ directory)
# ---------------------------------------------------------------------------
COPY --chown=frappe:frappe crm/                apps/crm/
COPY --chown=frappe:frappe setup.py            apps/crm/setup.py
COPY --chown=frappe:frappe pyproject.toml      apps/crm/pyproject.toml
COPY --chown=frappe:frappe requirements.txt    apps/crm/requirements.txt
COPY --chown=frappe:frappe MANIFEST.in         apps/crm/MANIFEST.in

# Install CRM into the bench virtualenv
RUN ./env/bin/pip install --no-cache-dir -e apps/crm

# Register app so `bench install-app crm` works
RUN echo "crm" >> sites/apps.txt

# ---------------------------------------------------------------------------
# Startup script
# ---------------------------------------------------------------------------
COPY --chown=frappe:frappe init-site.sh /home/frappe/init-site.sh
RUN chmod +x /home/frappe/init-site.sh

EXPOSE 8000 9000

CMD ["/home/frappe/init-site.sh"]
