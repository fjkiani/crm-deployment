# =============================================================================
# Dockerfile.frappe
# Frappe (develop branch) + CRM app — self-hosted, platform-agnostic
#
# DESIGN: This Dockerfile only installs system tools and the frappe-bench CLI.
# bench init (cloning Frappe from GitHub) runs at CONTAINER STARTUP in init-site.sh.
# This avoids GitHub network access during Docker build (which can fail in CI).
#
# The /home/frappe/frappe-bench directory is mounted as a persistent volume on Render,
# so bench init only runs once (on first boot). Subsequent starts skip it.
#
# One image, four roles (set via `command:` in docker-compose):
#   frappe-web       → /home/frappe/init-site.sh  (default)
#   frappe-worker    → bench worker --queue long,default,short
#   frappe-scheduler → bench schedule
#   frappe-socketio  → node apps/frappe/socketio.js
# =============================================================================

FROM python:3.11

# ---------------------------------------------------------------------------
# System dependencies
# nodejs from Debian Bookworm repos (no nodesource needed)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    default-libmysqlclient-dev \
    mariadb-client \
    git \
    redis-tools \
    gettext \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    libpng-dev \
    && npm install -g yarn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Non-root user (Frappe convention)
# ---------------------------------------------------------------------------
RUN useradd -ms /bin/bash frappe

# ---------------------------------------------------------------------------
# Install frappe-bench CLI (system-wide, /usr/local/bin/bench)
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir frappe-bench

# ---------------------------------------------------------------------------
# Copy CRM app source so init-site.sh can install it into the bench at runtime
# ---------------------------------------------------------------------------
COPY --chown=frappe:frappe crm/             /home/frappe/crm-app/
COPY --chown=frappe:frappe setup.py         /home/frappe/crm-app/setup.py
COPY --chown=frappe:frappe pyproject.toml   /home/frappe/crm-app/pyproject.toml
COPY --chown=frappe:frappe requirements.txt /home/frappe/crm-app/requirements.txt
COPY --chown=frappe:frappe MANIFEST.in      /home/frappe/crm-app/MANIFEST.in

# ---------------------------------------------------------------------------
# Startup script
# ---------------------------------------------------------------------------
COPY --chown=frappe:frappe init-site.sh /home/frappe/init-site.sh
RUN chmod +x /home/frappe/init-site.sh

# NOTE: Do NOT mkdir /home/frappe/frappe-bench here.
# The persistent volume is mounted at /home/frappe/frappe-bench at runtime.
# bench init creates this directory — if it already exists and is non-empty,
# init-site.sh skips bench init (idempotent check on env/bin/python).

EXPOSE 8000 9000

USER frappe
WORKDIR /home/frappe

CMD ["/home/frappe/init-site.sh"]
