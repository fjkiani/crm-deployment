# =============================================================================
# Dockerfile.frappe  —  multi-stage build
#
# Stage 1 (builder): runs bench init (clones Frappe from GitHub).
#   Uses python:3.11 (full image) to avoid missing library issues.
#   Node.js/yarn NOT needed (--skip-assets).
#
# Stage 2 (runtime): copies bench from builder, adds CRM app, sets entrypoint.
#   Container startup only does site creation / migration (fast, <2 min).
# =============================================================================

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11 AS builder

# git is the only extra dep needed for bench init
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash frappe

# Configure git globally (required by bench init which does git operations)
RUN git config --global user.email "frappe@example.com" && \
    git config --global user.name "Frappe"

RUN pip install --no-cache-dir frappe-bench

USER frappe
WORKDIR /home/frappe

# Configure git for frappe user
RUN git config --global user.email "frappe@example.com" && \
    git config --global user.name "Frappe"

# bench init: clones Frappe from GitHub and sets up the Python venv.
# --skip-assets  → no Node.js/yarn needed
# --no-procfile  → we manage processes ourselves
# --no-backups   → no cron backup setup
# This step takes ~8-12 min; subsequent builds use Docker layer cache.
RUN bench init \
    --frappe-branch develop \
    --frappe-path https://github.com/frappe/frappe \
    --skip-assets \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    frappe-bench

# Remove .git dirs to slim the image
RUN find /home/frappe/frappe-bench/apps -mindepth 1 -name ".git" -type d | xargs rm -rf

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm AS runtime

# Runtime deps: Node.js for asset serving, MariaDB client for mysqladmin
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    nodejs \
    npm \
    mariadb-client \
    redis-tools \
    gettext \
    libmariadb3 \
    libssl3 \
    libjpeg62-turbo \
    libpng16-16 \
    && npm install -g yarn \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash frappe

# Copy the fully-initialised bench from builder
COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

# Install frappe-bench CLI in the runtime image (needed for bench commands)
RUN pip install --no-cache-dir frappe-bench

# ---------------------------------------------------------------------------
# Copy CRM app source into the bench apps directory and pip-install it
# ---------------------------------------------------------------------------
COPY --chown=frappe:frappe crm/             /home/frappe/frappe-bench/apps/crm/crm/
COPY --chown=frappe:frappe setup.py         /home/frappe/frappe-bench/apps/crm/setup.py
COPY --chown=frappe:frappe pyproject.toml   /home/frappe/frappe-bench/apps/crm/pyproject.toml
COPY --chown=frappe:frappe requirements.txt /home/frappe/frappe-bench/apps/crm/requirements.txt
COPY --chown=frappe:frappe MANIFEST.in      /home/frappe/frappe-bench/apps/crm/MANIFEST.in

# Install CRM app into the bench venv
RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir \
    -e /home/frappe/frappe-bench/apps/crm \
    frappe-mcp==0.1.0

# Register CRM in apps.txt
RUN grep -qxF "crm" /home/frappe/frappe-bench/sites/apps.txt 2>/dev/null \
    || echo "crm" >> /home/frappe/frappe-bench/sites/apps.txt

# ---------------------------------------------------------------------------
# Startup script (handles site creation / migration at runtime)
# ---------------------------------------------------------------------------
COPY --chown=frappe:frappe init-site.sh /home/frappe/init-site.sh
RUN chmod +x /home/frappe/init-site.sh

EXPOSE 8000 9000

USER frappe
WORKDIR /home/frappe

CMD ["/home/frappe/init-site.sh"]
