# =============================================================================
# Dockerfile.frappe
#
# Uses frappe/erpnext:v16 as base (pre-built with bench + frappe + erpnext).
# We add our CRM app on top. No bench init needed — fast build (~2-3 min).
#
# The baked DB (frappe_baked.sql.gz) is generated by GitHub Actions:
#   1. CI runs bench new-site with 7GB RAM (no OOM)
#   2. CI dumps the DB to frappe_baked.sql.gz
#   3. This Dockerfile includes the dump in the image
#   4. At runtime, frappe_starter.py imports the dump (~30s) instead of
#      running bench new-site (~90 min)
#
# Runtime strategy:
#   - First boot with baked DB: import SQL + bench migrate (~2 min, runs once)
#   - First boot without baked DB: bench new-site (~90 min, fallback)
#   - Every subsequent boot: bench migrate (~30s) + gunicorn
#   - The Render disk at /home/frappe/frappe-bench/sites persists across deploys
#
# One image, three roles (CMD override in Render):
#   frappe-web       → python /home/frappe/frappe_starter.py  (default)
#   frappe-worker    → bench worker --queue long,default,short
#   frappe-scheduler → bench schedule
# =============================================================================

FROM frappe/erpnext:v16

USER root

# Install mariadb-client (mysql CLI for DB setup) + redis-server (local Redis
# for migrate — avoids external Redis dependency during first boot)
RUN apt-get update && apt-get install -y --no-install-recommends \
    mariadb-client \
    redis-server \
    build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

USER frappe

# Fix apps.txt: base image has stale 'erpnextcrm' entry which crashes bench
RUN printf 'frappe\nerpnext\ncrm\n' > /home/frappe/frappe-bench/sites/apps.txt && \
    echo "=== apps.txt ===" && cat /home/frappe/frappe-bench/sites/apps.txt

# Copy CRM app source
COPY --chown=frappe:frappe crm/             /home/frappe/frappe-bench/apps/crm/crm/
COPY --chown=frappe:frappe setup.py         /home/frappe/frappe-bench/apps/crm/setup.py
COPY --chown=frappe:frappe pyproject.toml   /home/frappe/frappe-bench/apps/crm/pyproject.toml
COPY --chown=frappe:frappe requirements.txt /home/frappe/frappe-bench/apps/crm/requirements.txt
COPY --chown=frappe:frappe MANIFEST.in      /home/frappe/frappe-bench/apps/crm/MANIFEST.in

# Install CRM app into bench venv
RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir \
    -e /home/frappe/frappe-bench/apps/crm

# Include the baked DB dump (generated by GitHub Actions CI).
# The baked-db/ directory is created by the CI workflow.
# If building locally without the baked DB, create an empty placeholder:
#   mkdir -p baked-db && touch baked-db/.gitkeep
# frappe_starter.py checks if the file exists before using it.
COPY --chown=frappe:frappe baked-db/ /home/frappe/baked-db/

# Move the baked DB to the expected location (if it exists)
RUN if [ -f /home/frappe/baked-db/frappe_baked.sql.gz ]; then \
        mv /home/frappe/baked-db/frappe_baked.sql.gz /home/frappe/frappe_baked.sql.gz && \
        echo "Baked DB included: $(ls -lh /home/frappe/frappe_baked.sql.gz)"; \
    else \
        echo "No baked DB found — will use bench new-site at runtime (slow first boot)"; \
    fi && \
    rm -rf /home/frappe/baked-db/

USER root
COPY frappe_starter.py /home/frappe/frappe_starter.py
COPY frappe_worker.sh /home/frappe/frappe_worker.sh
COPY frappe_scheduler.sh /home/frappe/frappe_scheduler.sh
RUN chmod +x /home/frappe/frappe_starter.py \
              /home/frappe/frappe_worker.sh \
              /home/frappe/frappe_scheduler.sh && \
    chown frappe:frappe /home/frappe/frappe_starter.py \
                        /home/frappe/frappe_worker.sh \
                        /home/frappe/frappe_scheduler.sh

USER frappe
WORKDIR /home/frappe

EXPOSE 10000 8000 9000

CMD ["python", "/home/frappe/frappe_starter.py"]
