# EAIA / Nyx agent — copy to .env and fill in values.

# ── LLM ──
LANGSMITH_API_KEY=...
OPENAI_API_KEY=...
ANTHROPIC_API_KEY=...

# ── Gmail (inbound/outbound) ──
GMAIL_SECRET=...
GMAIL_TOKEN=...

# ── CRM bridge (required for sync_nyx_fields + MCP tools) ──
FRAPPE_URL=http://127.0.0.1:8000
FRAPPE_API_KEY=...
FRAPPE_API_SECRET=...

# ── Enrichment sources ──
TAVILY_API_KEY=...
APOLLO_API_KEY=...
BRIGHTDATA_API_KEY=...
DIFFBOT_TOKEN=...
COHERE_API_KEY=...

# ── Tenant pack (outreach engine) ──
# crispro | acme — loads eaia/tenant/packs/<id>.yaml
NYX_TENANT_ID=crispro
NYX_COMPANY_NAME=...
NYX_INDUSTRY=...

# ── Optional: OpenRouter for in-Frappe email adjudication ──
OPENROUTER_API_KEY=...
