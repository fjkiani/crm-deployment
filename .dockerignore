# =============================================================================
# .dockerignore — excludes files from Docker build context
# Keeps the build context small and fast.
# Only the following are needed for Dockerfile.frappe:
#   crm/, setup.py, pyproject.toml, requirements.txt, MANIFEST.in, init-site.sh
# =============================================================================

# Large directories not needed for any Docker build
crm-bench-backup/
frappe-bench/
assistant/
crm-backend-deploy/
crm-deployment/
hack_lab/
docs/
crm_components/

# Scripts directory is only needed for farfalle builds (handled by rootDir in Render)
scripts/

# Cursor IDE rules
.cursor/

# Test files
test_*.py
verify_*.py
*.test.py
tests/

# Large data files
*.xlsx
*.csv
*.json
leads.csv
testingCsv.csv
secret-replacements.txt
cookies.txt

# Documentation (not needed in containers)
*.md
*.mdc
cursorRules.md
leadGen.mdc
folderStructure.md
website-layout.md

# Git
.git/
.gitignore
.gitattributes

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Node
node_modules/
.npm/

# Environment files (use Render env vars instead)
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Shell scripts not needed in container
start_all.sh
