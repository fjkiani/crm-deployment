# MariaDB configuration tuned for Frappe CRM
# Place at: docker/mariadb.cnf
# Mounted read-only into the mariadb container

[mysqld]
# Frappe requires utf8mb4 throughout
character-set-client-handshake = FALSE
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci

# InnoDB settings
innodb_file_per_table           = 1
innodb_buffer_pool_size         = 512M
innodb_log_file_size            = 128M
innodb_flush_log_at_trx_commit  = 2

# Frappe uses long index keys
innodb_large_prefix             = 1
innodb_file_format              = Barracuda

# Connection settings
max_connections                 = 150
wait_timeout                    = 28800
interactive_timeout             = 28800

# Slow query log (useful for debugging)
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 2

[mysql]
default-character-set           = utf8mb4

[client]
default-character-set           = utf8mb4
