# =============================================================================
# .env.example — CRM Self-Hosted Stack
# Copy to .env and fill in every REQUIRED value before running docker-compose.
# Never commit .env to version control.
#
#   cp .env.example .env
#   # edit .env
#   docker-compose up --build
# =============================================================================


# =============================================================================
# FRAPPE / MARIADB
# =============================================================================

# Hostname Frappe uses for the site.
# Local dev: crm.localhost
# Production: your public domain (e.g. crm.yourdomain.com)
FRAPPE_SITE_NAME=crm.localhost

# Frappe Administrator account password — REQUIRED
ADMIN_PASSWORD=

# MariaDB database name and user — REQUIRED
DB_NAME=crm_db

# MariaDB user password — REQUIRED (strong random string in production)
DB_PASSWORD=

# MariaDB root password (used only during first-boot site creation) — REQUIRED
DB_ROOT_PASSWORD=

# Frappe encryption key for sensitive fields.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP — losing it means losing access to encrypted data.
ENCRYPTION_KEY=


# =============================================================================
# REDIS (defaults work for docker-compose — only change for external Redis)
# =============================================================================
REDIS_CACHE_URL=redis://redis-cache:13000
REDIS_QUEUE_URL=redis://redis-queue:11000


# =============================================================================
# EAIA AGENT (Nyx)
# =============================================================================

# URL of the Frappe instance the agent talks to.
# docker-compose: http://frappe-web:8000 (internal service name)
# Production:     https://crm.yourdomain.com
FRAPPE_SITE_URL=http://frappe-web:8000

# Public URL of the EAIA agent itself (used in CORS + self-referencing calls)
EAIA_URL=http://eaia-agent:8001

# Frappe API credentials for the agent.
# Generated automatically by init-site.sh on first boot — check frappe-web logs.
# REQUIRED for agent → CRM communication (leave blank on first boot)
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# OpenAI API key — REQUIRED
OPENAI_API_KEY=

# Anthropic API key (Claude fallback) — optional
ANTHROPIC_API_KEY=

# LangSmith tracing — optional
LANGSMITH_API_KEY=

# Gmail OAuth credentials for EAIA email send/receive.
# See UPGRADE_README.md §6.3 for setup instructions.
# Base64-encode your client_secret.json and token.json files.
GMAIL_SECRET=
GMAIL_TOKEN=

# Tavily web search (lead enrichment) — optional
TAVILY_API_KEY=

# Nyx identity — customize per client/tenant
NYX_COMPANY_NAME=Zeta
NYX_INDUSTRY=life sciences


# =============================================================================
# FARFALLE CHAT UI
# =============================================================================

# CRITICAL: Next.js bakes NEXT_PUBLIC_API_URL into the JS bundle at BUILD time.
# For local dev: http://localhost:3001  (farfalle-backend on your machine)
# For production: set this to the PUBLIC URL of farfalle-backend BEFORE building.
#   e.g. https://crm-farfalle-backend.onrender.com
# Then rebuild: docker-compose build farfalle-frontend
FARFALLE_BACKEND_PUBLIC_URL=http://localhost:3001

# Farfalle Postgres password (internal — only change for external Postgres)
FARFALLE_DB_PASSWORD=farfalle

# CRM user for farfalle-backend intel queries (defaults to Administrator)
CRM_USER=Administrator


# =============================================================================
# PRODUCTION OVERRIDES
# Uncomment and set when deploying to Render / Railway / Fly.io / VPS
# =============================================================================

# Your public Frappe domain
# FRAPPE_SITE_NAME=crm.yourdomain.com

# Point EAIA at the public Frappe URL (not the internal docker service name)
# FRAPPE_SITE_URL=https://crm.yourdomain.com

# Point farfalle-frontend at the public farfalle-backend URL
# FARFALLE_BACKEND_PUBLIC_URL=https://crm-farfalle-backend.onrender.com
