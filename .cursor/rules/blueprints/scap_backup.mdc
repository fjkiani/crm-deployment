def minExchanges(n, c):
    # Find all groups of 1's
    groups = []
    i = 0
    while i < len(n):
        if n[i] == 1:
            start = i
            while i < len(n) and n[i] == 1:
                i += 1
            groups.append((start, i - 1))
        else:
            i += 1
    
    # If already have c consecutive 1's
    for start, end in groups:
        if end - start + 1 >= c:
            return 0
    
    # Total 1's needed
    total_ones = sum(n)
    if total_ones < c:
        return -1  # impossible
    
    # Sliding window: find window of size c with max 1's
    max_ones = 0
    for i in range(len(n) - c + 1):
        ones_in_window = sum(n[i:i+c])
        max_ones = max(max_ones, ones_in_window)
    
    # Min exchanges = zeros in best window
    return c - max_ones
CORE LOGIC:

Use sliding window of size c

Find window with maximum 1's already in it

Swaps needed = c - max_ones_in_window

