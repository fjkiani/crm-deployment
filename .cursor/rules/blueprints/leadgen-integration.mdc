### PII Data Access Rules
```python
# crm/api/leadgen.py
@frappe.whitelist()
def get_prospects(filters=None, limit=20, include_raw=False):
    """Get prospects with PII protection"""
    # Check user permissions
    if not frappe.has_permission("Lead Prospect", "read"):
        frappe.throw(_("Insufficient permissions"))
    
    # Apply row-level permissions
    if frappe.has_role("Sales User") and not frappe.has_role("Sales Manager"):
        filters = filters or {}
        filters["owner"] = frappe.session.user
    
    # Get prospects with field restrictions
    fields = [
        "name", "pi_name", "institution", "cancer_type", 
        "tier", "lead_score", "source", "source_ref_id"
    ]
    
    # Only managers can see raw data and PII
    if include_raw and frappe.has_role("Sales Manager"):
        fields.extend(["raw", "pi_email", "phone"])
    
    prospects = frappe.get_list(
        "Lead Prospect",
        fields=fields,
        filters=filters,
        limit=limit,
        order_by="lead_score desc"
    )
    
    return prospects
```

