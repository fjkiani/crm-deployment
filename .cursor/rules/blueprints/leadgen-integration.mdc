## API Integration Patterns

### LeadGen API Endpoints
```python
# crm/api/leadgen.py
import frappe
from frappe import _
from frappe.utils import now

@frappe.whitelist()
def run_collector(collector_type: str, params: dict):
    """Run a data collector"""
    # Validate collector type
    valid_collectors = ["clinicaltrials", "nih", "asco"]
    if collector_type not in valid_collectors:
        frappe.throw(_("Invalid collector type"))
    
    # Create job
    job = frappe.get_doc({
        "doctype": "LeadGen Job",
        "job_type": collector_type,
        "params": frappe.as_json(params),
        "status": "Queued"
    })
    job.insert()
    
    # Enqueue job
    frappe.enqueue(
        f"crm.leadgen.collectors.{collector_type}_collector.run",
        job_name=job.name,
        params=params,
        queue="long"
    )
    
    return {"job_name": job.name, "status": "Queued"}

@frappe.whitelist()
def promote_prospects(prospect_names: list):
    """Promote prospects to CRM entities"""
    promoted = []
    
    for prospect_name in prospect_names:
        prospect = frappe.get_doc("Lead Prospect", prospect_name)
        
        # Create CRM Lead
        lead = create_crm_lead_from_prospect(prospect)
        promoted.append(lead.name)
        
        # Create FCRM Note
        create_evidence_note(prospect, lead)
        
        # Update prospect
        prospect.linked_lead = lead.name
        prospect.save()
    
    return {"promoted": promoted}

@frappe.whitelist()
def start_outreach_sequence(prospect_names: list, sequence_type: str):
    """Start outreach sequence for prospects"""
    sequence = frappe.get_doc("Outreach Sequence", sequence_type)
    
    for prospect_name in prospect_names:
        prospect = frappe.get_doc("Lead Prospect", prospect_name)
        
        # Create sequence instance
        instance = frappe.get_doc({
            "doctype": "Outreach Sequence Instance",
            "sequence": sequence.name,
            "prospect": prospect.name,
            "status": "Active",
            "start_date": now()
        })
        instance.insert()
        
        # Schedule first step
        schedule_next_step(instance)
    
    return {"status": "success"}

def create_crm_lead_from_prospect(prospect):
    """Create CRM Lead from Lead Prospect"""
    lead = frappe.get_doc({
        "doctype": "CRM Lead",
        "lead_name": prospect.pi_name,
        "email_id": prospect.pi_email,
        "mobile_no": prospect.phone,
        "company": prospect.institution,
        "source": "Lead Generation",
        "custom_lead_score": prospect.lead_score,
        "custom_tier": prospect.tier,
        "custom_prospect_ref": prospect.name,
        "custom_cancer_type": prospect.cancer_type,
        "custom_endpoint_summary": prospect.endpoint_summary
    })
    lead.insert()
    return lead

def create_evidence_note(prospect, lead):
    """Create evidence note for lead"""
    note = frappe.get_doc({
        "doctype": "FCRM Note",
        "reference_doctype": "CRM Lead",
        "reference_name": lead.name,
        "note": f"""
        Lead Generation Evidence:
        - Source: {prospect.source}
        - Reference ID: {prospect.source_ref_id}
        - Cancer Type: {prospect.cancer_type}
        - Endpoint: {prospect.endpoint_summary}
        - Funding: ${prospect.funding_total:,} if prospect.funding_total else "N/A"
        - H-Index: {prospect.h_index if prospect.h_index else "N/A"}
        """,
        "note_type": "Evidence"
    })
    note.insert()
    return note
```

