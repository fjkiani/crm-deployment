### Lead Prospect Integration
```python
# crm/fcrm/doctype/lead_prospect/lead_prospect.py
import frappe
from frappe.model.document import Document

class LeadProspect(Document):
    def on_update(self):
        """Handle prospect updates"""
        if self.has_value_changed("tier") and self.tier == "Tier 1":
            self.trigger_tier1_workflow()
    
    def trigger_tier1_workflow(self):
        """Trigger Tier 1 workflow"""
        # Create CRM Lead
        lead = frappe.get_doc({
            "doctype": "CRM Lead",
            "lead_name": self.pi_name,
            "email_id": self.pi_email,
            "mobile_no": self.phone,
            "company": self.institution,
            "source": "Lead Generation",
            "custom_lead_score": self.lead_score,
            "custom_tier": self.tier,
            "custom_prospect_ref": self.name
        })
        lead.insert()
        
        # Create FCRM Note with evidence
        note = frappe.get_doc({
            "doctype": "FCRM Note",
            "reference_doctype": "CRM Lead",
            "reference_name": lead.name,
            "note": f"Promoted from Lead Prospect: {self.source_ref_id}",
            "note_type": "Evidence"
        })
        note.insert()
        
        # Link prospect to lead
        self.linked_lead = lead.name
        self.save()
