### LeadGen Job Integration
```python
# crm/fcrm/doctype/leadgen_job/leadgen_job.py
import frappe
from frappe.model.document import Document

class LeadGenJob(Document):
    def on_update(self):
        """Update job status and trigger notifications"""
        if self.status == "Completed":
            self.notify_completion()
        elif self.status == "Failed":
            self.notify_failure()
    
    def notify_completion(self):
        """Notify users of job completion"""
        frappe.publish_realtime(
            "leadgen_job_completed",
            {
                "job_name": self.name,
                "job_type": self.job_type,
                "message": self.log
            }
        )
    
    def notify_failure(self):
        """Notify users of job failure"""
        frappe.publish_realtime(
            "leadgen_job_failed",
            {
                "job_name": self.name,
                "job_type": self.job_type,
                "error": self.log
            }
        )
