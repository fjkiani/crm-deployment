## Unified Job Orchestration

### Single Job System Integration
Reference: [crm/api/etl.py](mdc:crm/api/etl.py)

**CRITICAL**: Use existing Frappe queue system instead of creating parallel job infrastructure.

**Unified Job Pattern:**
```python
# crm/api/leadgen.py - Unified with existing ETL job system
@frappe.whitelist()
def run_leadgen_job(job_type: str, params: dict):
    """Run lead generation job using unified job system"""
    # Create LeadGen Job DocType (extends CRM Import Job pattern)
    job = frappe.get_doc({
        "doctype": "LeadGen Job",
        "job_type": job_type,  # "clinicaltrials", "nih", "asco", "consolidate"
        "params": frappe.as_json(params),
        "status": "Queued",
        "owner": frappe.session.user
    })
    job.insert()
    
    # Use existing Frappe enqueue system
    frappe.enqueue(
        f"crm.leadgen.collectors.{job_type}_collector.run",
        job_name=job.name,
        params=params,
        queue="long",  # Use existing queue system
        timeout=3600
    )
    
    return {"job_name": job.name, "status": "Queued"}

# crm/leadgen/collectors/clinicaltrials_collector.py
def run(job_name: str, params: dict):
    """Run ClinicalTrials collector using unified job system"""
    job = frappe.get_doc("LeadGen Job", job_name)
    
    try:
        # Update job status using existing pattern
        job.status = "Running"
        job.started_at = frappe.utils.now()
        job.save()
        
        # Collect data with bookmark pagination
        trials = collect_trials_with_bookmark(params, job.bookmark)
        
        # Process and save prospects
        prospects = process_trials(trials)
        save_prospects(prospects)
        
        # Update bookmark for resumability
        job.bookmark = get_next_bookmark(trials)
        
        # Complete job
        job.status = "Completed"
        job.ended_at = frappe.utils.now()
        job.log = f"Collected {len(trials)} trials, created {len(prospects)} prospects"
        job.save()
        
    except Exception as e:
        # Error handling using existing pattern
        job.status = "Failed"
        job.log = f"Error: {str(e)}"
        job.save()
        frappe.log_error(f"LeadGen Job {job_name} failed: {str(e)}")

def collect_trials_with_bookmark(params: dict, bookmark: str = None):
    """Collect trials with bookmark pagination for resumability"""
    trials = []
    page = 1
    
    if bookmark:
        # Resume from bookmark
        page = int(bookmark) if bookmark.isdigit() else 1
    
    while True:
        try:
            page_trials = fetch_page(page, params)
            if not page_trials:
                break
                
            trials.extend(page_trials)
            
            # Rate limiting
            time.sleep(60 / params.get("rate_limit", 100))
            page += 1
            
        except Exception as e:
            frappe.log_error(f"Error fetching page {page}: {str(e)}")
            break
    
    return trials
```

