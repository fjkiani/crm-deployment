## Data Processing Script Patterns

### Lead Consolidation Script
```python
# scripts/leadgen/processors/consolidate_leads.py
import pandas as pd
import json
from typing import List, Dict
import logging
from datetime import datetime

class LeadConsolidator:
    """Consolidate leads from multiple sources"""
    
    def __init__(self, config: Dict):
        self.config = config
        self.logger = logging.getLogger(__name__)
    
    def consolidate_leads(self, source_files: List[str]) -> pd.DataFrame:
        """Consolidate leads from multiple source files"""
        all_leads = []
        
        for file_path in source_files:
            leads = self._load_source_file(file_path)
            all_leads.extend(leads)
        
        # Convert to DataFrame
        df = pd.DataFrame(all_leads)
        
        # Deduplicate
        df = self._deduplicate_leads(df)
        
        # Score leads
        df = self._score_leads(df)
        
        # Tier leads
        df = self._tier_leads(df)
        
        return df
    
    def _load_source_file(self, file_path: str) -> List[Dict]:
        """Load leads from a source file"""
        try:
            with open(file_path, "r") as f:
                data = json.load(f)
            return data
        except Exception as e:
            self.logger.error(f"Error loading {file_path}: {str(e)}")
            return []
    
    def _deduplicate_leads(self, df: pd.DataFrame) -> pd.DataFrame:
        """Remove duplicate leads"""
        # Group by email
        email_groups = df.groupby("pi_email")
        
        deduplicated = []
        for email, group in email_groups:
            if len(group) == 1:
                deduplicated.append(group.iloc[0])
            else:
                # Merge duplicates
                merged = self._merge_duplicates(group)
                deduplicated.append(merged)
        
        return pd.DataFrame(deduplicated)
    
    def _merge_duplicates(self, group: pd.DataFrame) -> Dict:
        """Merge duplicate leads"""
        # Sort by source priority
        source_priority = {"trials": 3, "nih": 2, "asco": 1}
        group["source_priority"] = group["source"].map(source_priority)
        group = group.sort_values("source_priority", ascending=False)
        
        # Use highest priority as base
        merged = group.iloc[0].to_dict()
        
        # Merge additional data
        for _, row in group.iloc[1:].iterrows():
            for field in ["phone", "institution", "h_index", "recent_papers"]:
                if pd.isna(merged[field]) and not pd.isna(row[field]):
                    merged[field] = row[field]
            
            # Combine source references
            if not pd.isna(row["source_ref_id"]):
                if pd.isna(merged["source_ref_id"]):
                    merged["source_ref_id"] = row["source_ref_id"]
                else:
                    merged["source_ref_id"] += f", {row['source_ref_id']}"
        
        return merged
    
    def _score_leads(self, df: pd.DataFrame) -> pd.DataFrame:
        """Score leads based on multiple factors"""
        scores = []
        
        for _, row in df.iterrows():
            score = 0
            
            # Funding amount (0-30 points)
            if pd.notna(row.get("funding_total")):
                score += min(30, row["funding_total"] / 1000000 * 2)
            
            # H-index (0-25 points)
            if pd.notna(row.get("h_index")):
                score += min(25, row["h_index"] / 2)
            
            # Recent papers (0-20 points)
            if pd.notna(row.get("recent_papers")):
                paper_count = len(str(row["recent_papers"]).split(","))
                score += min(20, paper_count * 2)
            
            # Cancer type relevance (0-15 points)
            priority_cancers = ["breast", "lung", "colorectal", "prostate"]
            if any(cancer in str(row.get("cancer_type", "")).lower() for cancer in priority_cancers):
                score += 15
            
            # Source quality (0-10 points)
            source_scores = {"trials": 10, "nih": 8, "asco": 6, "manual": 5}
            score += source_scores.get(row.get("source"), 0)
            
            scores.append(int(score))
        
        df["lead_score"] = scores
        return df
    
    def _tier_leads(self, df: pd.DataFrame) -> pd.DataFrame:
        """Assign tiers based on lead score"""
        tiers = []
        
        for score in df["lead_score"]:
            if score >= 80:
                tiers.append("Tier 1")
            elif score >= 60:
                tiers.append("Tier 2")
            else:
                tiers.append("Tier 3")
        
        df["tier"] = tiers
        return df

def main():
    """Main function for standalone execution"""
    import argparse
    
    parser = argparse.ArgumentParser(description="Consolidate lead data")
    parser.add_argument("--sources", nargs="+", required=True)
    parser.add_argument("--output", default="data/lead_gen/master_leads.csv")
    
    args = parser.parse_args()
    
    config = {}
    consolidator = LeadConsolidator(config)
    
    print("Starting lead consolidation...")
    df = consolidator.consolidate_leads(args.sources)
    
    # Save results
    import os
    os.makedirs(os.path.dirname(args.output), exist_ok=True)
    df.to_csv(args.output, index=False)
    
    print(f"Consolidated {len(df)} leads")
    print(f"Tier 1: {len(df[df['tier'] == 'Tier 1'])}")
    print(f"Tier 2: {len(df[df['tier'] == 'Tier 2'])}")
    print(f"Tier 3: {len(df[df['tier'] == 'Tier 3'])}")
    print(f"Results saved to {args.output}")

if __name__ == "__main__":
    main()
```

## Outreach Script Patterns

### Email Sender Script
```python
# scripts/leadgen/outreach/email_sender.py
import smtplib
import ssl
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from email.mime.base import MIMEBase
from email import encoders
import pandas as pd
from typing import Dict, List
import logging
from datetime import datetime

class EmailSender:
    """Send outreach emails to leads"""
    
    def __init__(self, config: Dict):
        self.smtp_server = config["smtp_server"]
        self.smtp_port = config["smtp_port"]
        self.sender_email = config["sender_email"]
        self.sender_password = config["sender_password"]
        self.sender_name = config.get("sender_name", "Fahad")
        self.logger = logging.getLogger(__name__)
    
    def send_tier_emails(self, leads_df: pd.DataFrame, tier: str, template_type: str):
        """Send emails to leads of a specific tier"""
        tier_leads = leads_df[leads_df["tier"] == tier]
        
        sent_emails = []
        failed_emails = []
        
        for _, lead in tier_leads.iterrows():
            try:
                # Generate email content
                email_content = self._generate_email_content(lead, template_type)
                
                # Send email
                self._send_email(lead["pi_email"], email_content)
                
                # Log success
                sent_emails.append({
                    "pi_name": lead["pi_name"],
                    "pi_email": lead["pi_email"],
                    "tier": tier,
                    "sent_at": datetime.now().isoformat(),
                    "template_type": template_type
                })
                
                self.logger.info(f"Sent email to {lead['pi_name']} ({lead['pi_email']})")
                
            except Exception as e:
                failed_emails.append({
                    "pi_name": lead["pi_name"],
                    "pi_email": lead["pi_email"],
                    "error": str(e)
                })
                
                self.logger.error(f"Failed to send email to {lead['pi_name']}: {str(e)}")
        
        return sent_emails, failed_emails
    
    def _generate_email_content(self, lead: pd.Series, template_type: str) -> Dict:
        """Generate email content based on template type"""
        if template_type == "tier1":
            return self._generate_tier1_template(lead)
        elif template_type == "tier2":
            return self._generate_tier2_template(lead)
        else:
            return self._generate_default_template(lead)
    
    def _generate_tier1_template(self, lead: pd.Series) -> Dict:
        """Generate Tier 1 email template"""
        subject = f"Genomic stratification for {lead.get('trial_title', 'your trial')}"
        
        body = f"""
Dr. {lead['pi_name']},

I came across your {lead.get('cancer_type', 'oncology')} trial ({lead.get('source_ref_id', '')}) and was impressed by your approach to {lead.get('endpoint', 'patient outcomes')}.

Given the 60% failure rate in Phase 3 oncology trials, I wanted to share how genomic patient stratification could improve your trial's success probability.

Our validation data shows AUROC 0.976 across 38 cancer targets, with particular strength in {lead.get('cancer_type', 'oncology')} stratification.

Would you be interested in a brief call to discuss how this could apply to your trial?

Best regards,
{self.sender_name}
{self.sender_email}
"""
        
        return {"subject": subject, "body": body}
    
    def _generate_tier2_template(self, lead: pd.Series) -> Dict:
        """Generate Tier 2 email template"""
        subject = f"Improving {lead.get('cancer_type', 'oncology')} trial outcomes"
        
        body = f"""
Dr. {lead['pi_name']},

Your work on {lead.get('endpoint', 'patient outcomes')} caught my attention.

I'm reaching out because genomic patient stratification has shown significant promise in improving Phase 3 oncology trial success rates.

Would you be open to a brief discussion about how this could benefit your research?

Best,
{self.sender_name}
{self.sender_email}
"""
        
        return {"subject": subject, "body": body}
    
    def _generate_default_template(self, lead: pd.Series) -> Dict:
        """Generate default email template"""
        subject = "Genomic stratification for oncology trials"
        
        body = f"""
Dr. {lead['pi_name']},

I hope this email finds you well. I'm reaching out regarding genomic patient stratification for oncology trials.

Our platform has shown promising results in improving trial success rates through better patient selection.

Would you be interested in learning more?

Best regards,
{self.sender_name}
{self.sender_email}
"""
        
        return {"subject": subject, "body": body}
    
    def _send_email(self, recipient_email: str, email_content: Dict):
        """Send email via SMTP"""
        # Create message
        message = MIMEMultipart()
        message["From"] = f"{self.sender_name} <{self.sender_email}>"
        message["To"] = recipient_email
        message["Subject"] = email_content["subject"]
        
        # Add body
        message.attach(MIMEText(email_content["body"], "plain"))
        
        # Create secure connection
        context = ssl.create_default_context()
        
        with smtplib.SMTP(self.smtp_server, self.smtp_port) as server:
            server.starttls(context=context)
            server.login(self.sender_email, self.sender_password)
            server.send_message(message)

def main():
    """Main function for standalone execution"""
    import argparse
    
    parser = argparse.ArgumentParser(description="Send outreach emails")
    parser.add_argument("--leads-file", required=True)
    parser.add_argument("--tier", choices=["Tier 1", "Tier 2", "Tier 3"], required=True)
    parser.add_argument("--template", choices=["tier1", "tier2", "default"], required=True)
    parser.add_argument("--config", required=True)
    
    args = parser.parse_args()
    
    # Load config
    with open(args.config, "r") as f:
        config = json.load(f)
    
    # Load leads
    leads_df = pd.read_csv(args.leads_file)
    
    # Send emails
    sender = EmailSender(config)
    sent_emails, failed_emails = sender.send_tier_emails(leads_df, args.tier, args.template)
    
    # Save results
    import os
    os.makedirs("data/lead_gen", exist_ok=True)
    
    if sent_emails:
        sent_df = pd.DataFrame(sent_emails)
        sent_df.to_csv(f"data/lead_gen/{args.tier.lower().replace(' ', '_')}_sent.csv", index=False)
    
    if failed_emails:
        failed_df = pd.DataFrame(failed_emails)
        failed_df.to_csv(f"data/lead_gen/{args.tier.lower().replace(' ', '_')}_failed.csv", index=False)
    
    print(f"Sent {len(sent_emails)} emails, {len(failed_emails)} failed")

if __name__ == "__main__":
    main()
