### ClinicalTrials.gov Scraper
```python
# scripts/leadgen/collectors/clinicaltrials_scraper.py
import requests
import json
import time
from datetime import datetime
from typing import List, Dict, Optional
import logging

class ClinicalTrialsScraper:
    """Scraper for ClinicalTrials.gov API"""
    
    def __init__(self, config: Dict):
        self.base_url = "https://clinicaltrials.gov/api/v2/studies"
        self.rate_limit = config.get("rate_limit", 100)  # requests per minute
        self.max_retries = config.get("max_retries", 3)
        self.timeout = config.get("timeout", 30)
        self.logger = logging.getLogger(__name__)
        
    def scrape_trials(self, params: Dict) -> List[Dict]:
        """Scrape trials based on parameters"""
        trials = []
        page = 1
        
        while True:
            try:
                page_trials = self._fetch_page(page, params)
                if not page_trials:
                    break
                    
                trials.extend(page_trials)
                self.logger.info(f"Fetched page {page}, total trials: {len(trials)}")
                
                # Rate limiting
                time.sleep(60 / self.rate_limit)
                page += 1
                
            except Exception as e:
                self.logger.error(f"Error fetching page {page}: {str(e)}")
                if page > 1:  # Don't fail on first page
                    break
                raise
        
        return trials
    
    def _fetch_page(self, page: int, params: Dict) -> List[Dict]:
        """Fetch a single page of trials"""
        query_params = {
            "query.cond": " OR ".join(params.get("conditions", [])),
            "query.intr": " OR ".join(params.get("interventions", [])),
            "query.phase": " OR ".join(params.get("phases", [])),
            "format": "json",
            "pageSize": params.get("page_size", 100),
            "page": page
        }
        
        for attempt in range(self.max_retries):
            try:
                response = requests.get(
                    self.base_url,
                    params=query_params,
                    timeout=self.timeout
                )
                response.raise_for_status()
                
                data = response.json()
                return data.get("studies", [])
                
            except requests.exceptions.RequestException as e:
                if attempt == self.max_retries - 1:
                    raise
                time.sleep(2 ** attempt)  # Exponential backoff
    
    def extract_pi_info(self, trial: Dict) -> Optional[Dict]:
        """Extract Principal Investigator information from trial"""
        try:
            # Navigate through trial structure to find PI info
            protocol_section = trial.get("protocolSection", {})
            identification_module = protocol_section.get("identificationModule", {})
            contacts_locations_module = protocol_section.get("contactsLocationsModule", {})
            
            # Extract PI name and contact info
            pi_info = {
                "trial_id": identification_module.get("nctId"),
                "trial_title": identification_module.get("briefTitle"),
                "pi_name": None,
                "pi_email": None,
                "institution": None,
                "cancer_type": self._extract_cancer_type(trial),
                "phase": self._extract_phase(trial),
                "enrollment": self._extract_enrollment(trial),
                "endpoint": self._extract_endpoint(trial)
            }
            
            # Extract PI contact info
            locations = contacts_locations_module.get("locations", [])
            if locations:
                location = locations[0]  # Primary location
                pi_info["institution"] = location.get("facility", {}).get("name")
                
                # Look for PI contact in location
                contacts = location.get("contacts", [])
                for contact in contacts:
                    if contact.get("type") == "PRIMARY":
                        pi_info["pi_name"] = contact.get("name")
                        pi_info["pi_email"] = contact.get("email")
                        break
            
            return pi_info if pi_info["pi_name"] else None
            
        except Exception as e:
            self.logger.error(f"Error extracting PI info: {str(e)}")
            return None
    
    def _extract_cancer_type(self, trial: Dict) -> str:
        """Extract cancer type from trial conditions"""
        conditions = trial.get("protocolSection", {}).get("conditionsModule", {}).get("conditions", [])
        if conditions:
            return conditions[0].lower()
        return "unknown"
    
    def _extract_phase(self, trial: Dict) -> str:
        """Extract phase from trial design"""
        design = trial.get("protocolSection", {}).get("designModule", {})
        phases = design.get("phases", [])
        if phases:
            return phases[0]
        return "unknown"
    
    def _extract_enrollment(self, trial: Dict) -> int:
        """Extract enrollment number"""
        design = trial.get("protocolSection", {}).get("designModule", {})
        enrollment = design.get("enrollmentInfo", {}).get("count")
        return int(enrollment) if enrollment else 0
    
    def _extract_endpoint(self, trial: Dict) -> str:
        """Extract primary endpoint"""
        outcomes = trial.get("protocolSection", {}).get("outcomesModule", {})
        primary_outcomes = outcomes.get("primaryOutcomes", [])
        if primary_outcomes:
            return primary_outcomes[0].get("description", "unknown")
        return "unknown"

def main():
    """Main function for standalone execution"""
    import argparse
    
    parser = argparse.ArgumentParser(description="Scrape ClinicalTrials.gov")
    parser.add_argument("--conditions", nargs="+", default=["breast cancer", "lung cancer"])
    parser.add_argument("--phases", nargs="+", default=["Phase 3"])
    parser.add_argument("--output", default="data/lead_gen/clinicaltrials_raw.json")
    parser.add_argument("--page-size", type=int, default=100)
    
    args = parser.parse_args()
    
    config = {
        "rate_limit": 100,
        "max_retries": 3,
        "timeout": 30
    }
    
    scraper = ClinicalTrialsScraper(config)
    
    params = {
        "conditions": args.conditions,
        "phases": args.phases,
        "page_size": args.page_size
    }
    
    print("Starting ClinicalTrials.gov scrape...")
    trials = scraper.scrape_trials(params)
    
    # Extract PI info
    pi_data = []
    for trial in trials:
        pi_info = scraper.extract_pi_info(trial)
        if pi_info:
            pi_data.append(pi_info)
    
    # Save results
    import os
    os.makedirs(os.path.dirname(args.output), exist_ok=True)
    
    with open(args.output, "w") as f:
        json.dump(pi_data, f, indent=2)
    
    print(f"Scraped {len(trials)} trials, extracted {len(pi_data)} PI records")
    print(f"Results saved to {args.output}")

if __name__ == "__main__":
    main()
```

### NIH RePORTER Scraper
```python
# scripts/leadgen/collectors/nih_reporter_scraper.py
import requests
import json
import time
from datetime import datetime
from typing import List, Dict, Optional
import logging

class NIHReporterScraper:
    """Scraper for NIH RePORTER API"""
    
    def __init__(self, config: Dict):
        self.base_url = "https://api.reporter.nih.gov/v2/projects/search"
        self.rate_limit = config.get("rate_limit", 1000)  # requests per day
        self.max_retries = config.get("max_retries", 3)
        self.timeout = config.get("timeout", 30)
        self.logger = logging.getLogger(__name__)
    
    def scrape_grants(self, params: Dict) -> List[Dict]:
        """Scrape grants based on parameters"""
        grants = []
        offset = 0
        page_size = params.get("page_size", 100)
        
        while True:
            try:
                page_grants = self._fetch_page(offset, page_size, params)
                if not page_grants:
                    break
                
                grants.extend(page_grants)
                self.logger.info(f"Fetched offset {offset}, total grants: {len(grants)}")
                
                # Rate limiting
                time.sleep(60 / (self.rate_limit / 24))  # Distribute over 24 hours
                offset += page_size
                
            except Exception as e:
                self.logger.error(f"Error fetching offset {offset}: {str(e)}")
                if offset > 0:  # Don't fail on first page
                    break
                raise
        
        return grants
    
    def _fetch_page(self, offset: int, page_size: int, params: Dict) -> List[Dict]:
        """Fetch a single page of grants"""
        payload = {
            "criteria": {
                "advanced_text_search": {
                    "operator": "and",
                    "search_field": "all",
                    "search_text": " OR ".join(params.get("keywords", []))
                },
                "activity_codes": params.get("activity_codes", []),
                "fiscal_years": params.get("fiscal_years", [2024, 2025])
            },
            "offset": offset,
            "limit": page_size,
            "sort_field": "project_start_date",
            "sort_order": "desc"
        }
        
        for attempt in range(self.max_retries):
            try:
                response = requests.post(
                    self.base_url,
                    json=payload,
                    timeout=self.timeout
                )
                response.raise_for_status()
                
                data = response.json()
                return data.get("results", [])
                
            except requests.exceptions.RequestException as e:
                if attempt == self.max_retries - 1:
                    raise
                time.sleep(2 ** attempt)  # Exponential backoff
    
    def extract_pi_info(self, grant: Dict) -> Optional[Dict]:
        """Extract Principal Investigator information from grant"""
        try:
            pi_info = {
                "grant_id": grant.get("appl_id"),
                "project_title": grant.get("project_title"),
                "pi_name": grant.get("contact_pi_name"),
                "pi_email": grant.get("contact_pi_email"),
                "institution": grant.get("org_name"),
                "cancer_type": self._extract_cancer_type(grant),
                "funding_total": grant.get("total_cost"),
                "project_start_date": grant.get("project_start_date"),
                "project_end_date": grant.get("project_end_date"),
                "abstract": grant.get("abstract_text")
            }
            
            return pi_info if pi_info["pi_name"] else None
            
        except Exception as e:
            self.logger.error(f"Error extracting PI info: {str(e)}")
            return None
    
    def _extract_cancer_type(self, grant: Dict) -> str:
        """Extract cancer type from grant title/abstract"""
        text = f"{grant.get('project_title', '')} {grant.get('abstract_text', '')}".lower()
        
        cancer_types = [
            "breast cancer", "lung cancer", "colorectal cancer", "prostate cancer",
            "pancreatic cancer", "ovarian cancer", "cervical cancer", "melanoma",
            "leukemia", "lymphoma", "brain cancer", "liver cancer"
        ]
        
        for cancer_type in cancer_types:
            if cancer_type in text:
                return cancer_type
        
        return "unknown"

def main():
    """Main function for standalone execution"""
    import argparse
    
    parser = argparse.ArgumentParser(description="Scrape NIH RePORTER")
    parser.add_argument("--keywords", nargs="+", default=["oncology", "cancer", "clinical trial"])
    parser.add_argument("--activity-codes", nargs="+", default=["R01", "R21", "R43"])
    parser.add_argument("--output", default="data/lead_gen/nih_raw.json")
    parser.add_argument("--page-size", type=int, default=100)
    
    args = parser.parse_args()
    
    config = {
        "rate_limit": 1000,
        "max_retries": 3,
        "timeout": 30
    }
    
    scraper = NIHReporterScraper(config)
    
    params = {
        "keywords": args.keywords,
        "activity_codes": args.activity_codes,
        "page_size": args.page_size
    }
    
    print("Starting NIH RePORTER scrape...")
    grants = scraper.scrape_grants(params)
    
    # Extract PI info
    pi_data = []
    for grant in grants:
        pi_info = scraper.extract_pi_info(grant)
        if pi_info:
            pi_data.append(pi_info)
    
    # Save results
    import os
    os.makedirs(os.path.dirname(args.output), exist_ok=True)
    
    with open(args.output, "w") as f:
        json.dump(pi_data, f, indent=2)
    
    print(f"Scraped {len(grants)} grants, extracted {len(pi_data)} PI records")
    print(f"Results saved to {args.output}")

if __name__ == "__main__":
    main()
