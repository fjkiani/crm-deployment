## Logging Patterns

### Structured Logging
```python
# scripts/leadgen/utils/logger.py
import logging
import json
from datetime import datetime
from typing import Dict, Any

class StructuredLogger:
    """Structured logger for lead generation scripts"""
    
    def __init__(self, name: str, log_file: str = None):
        self.logger = logging.getLogger(name)
        self.logger.setLevel(logging.INFO)
        
        # Console handler
        console_handler = logging.StreamHandler()
        console_handler.setLevel(logging.INFO)
        
        # File handler
        if log_file:
            file_handler = logging.FileHandler(log_file)
            file_handler.setLevel(logging.DEBUG)
            self.logger.addHandler(file_handler)
        
        # Formatter
        formatter = logging.Formatter(
            '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
        )
        console_handler.setFormatter(formatter)
        if log_file:
            file_handler.setFormatter(formatter)
        
        self.logger.addHandler(console_handler)
    
    def log_event(self, event_type: str, data: Dict[str, Any]):
        """Log structured event"""
        log_data = {
            "timestamp": datetime.now().isoformat(),
            "event_type": event_type,
            "data": data
        }
        
        self.logger.info(json.dumps(log_data))
    
    def log_scrape_start(self, source: str, params: Dict[str, Any]):
        """Log scrape start"""
        self.log_event("scrape_start", {
            "source": source,
            "params": params
        })
    
    def log_scrape_complete(self, source: str, count: int, duration: float):
        """Log scrape completion"""
        self.log_event("scrape_complete", {
            "source": source,
            "count": count,
            "duration": duration
        })
    
    def log_email_sent(self, recipient: str, tier: str, template: str):
        """Log email sent"""
        self.log_event("email_sent", {
            "recipient": recipient,
            "tier": tier,
            "template": template
        })
    
    def log_error(self, error_type: str, error_message: str, context: Dict[str, Any] = None):
        """Log error"""
        self.log_event("error", {
            "error_type": error_type,
            "error_message": error_message,
            "context": context or {}
        })
