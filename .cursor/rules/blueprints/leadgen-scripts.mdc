## Main Script Pattern

### Orchestration Script
```python
# scripts/leadgen/main.py
import argparse
import json
import os
from datetime import datetime
from typing import Dict, List

from collectors.clinicaltrials_scraper import ClinicalTrialsScraper
from collectors.nih_reporter_scraper import NIHReporterScraper
from processors.consolidate_leads import LeadConsolidator
from outreach.email_sender import EmailSender
from utils.config import ConfigManager
from utils.logger import StructuredLogger

class LeadGenOrchestrator:
    """Orchestrate the entire lead generation process"""
    
    def __init__(self, config_file: str):
        self.config = ConfigManager(config_file)
        self.logger = StructuredLogger("LeadGenOrchestrator")
        
        # Initialize components
        self.clinicaltrials_scraper = ClinicalTrialsScraper(
            self.config.get("apis.clinicaltrials", {})
        )
        self.nih_scraper = NIHReporterScraper(
            self.config.get("apis.nih", {})
        )
        self.consolidator = LeadConsolidator(
            self.config.get("scoring", {})
        )
        self.email_sender = EmailSender(
            self.config.get("smtp", {})
        )
    
    def run_full_pipeline(self, params: Dict):
        """Run the complete lead generation pipeline"""
        self.logger.log_event("pipeline_start", {"params": params})
        
        try:
            # Step 1: Collect data
            self._collect_data(params)
            
            # Step 2: Consolidate leads
            self._consolidate_leads()
            
            # Step 3: Send emails (if requested)
            if params.get("send_emails", False):
                self._send_outreach_emails(params)
            
            self.logger.log_event("pipeline_complete", {"status": "success"})
            
        except Exception as e:
            self.logger.log_error("pipeline_error", str(e))
            raise
    
    def _collect_data(self, params: Dict):
        """Collect data from all sources"""
        sources = params.get("sources", ["clinicaltrials", "nih"])
        
        for source in sources:
            if source == "clinicaltrials":
                self._collect_clinicaltrials(params)
            elif source == "nih":
                self._collect_nih(params)
    
    def _collect_clinicaltrials(self, params: Dict):
        """Collect ClinicalTrials.gov data"""
        self.logger.log_scrape_start("clinicaltrials", params)
        
        start_time = datetime.now()
        trials = self.clinicaltrials_scraper.scrape_trials(params)
        
        # Extract PI info
        pi_data = []
        for trial in trials:
            pi_info = self.clinicaltrials_scraper.extract_pi_info(trial)
            if pi_info:
                pi_data.append(pi_info)
        
        # Save results
        output_file = "data/lead_gen/clinicaltrials_raw.json"
        os.makedirs(os.path.dirname(output_file), exist_ok=True)
        
        with open(output_file, "w") as f:
            json.dump(pi_data, f, indent=2)
        
        duration = (datetime.now() - start_time).total_seconds()
        self.logger.log_scrape_complete("clinicaltrials", len(pi_data), duration)
    
    def _collect_nih(self, params: Dict):
        """Collect NIH RePORTER data"""
        self.logger.log_scrape_start("nih", params)
        
        start_time = datetime.now()
        grants = self.nih_scraper.scrape_grants(params)
        
        # Extract PI info
        pi_data = []
        for grant in grants:
            pi_info = self.nih_scraper.extract_pi_info(grant)
            if pi_info:
                pi_data.append(pi_info)
        
        # Save results
        output_file = "data/lead_gen/nih_raw.json"
        os.makedirs(os.path.dirname(output_file), exist_ok=True)
        
        with open(output_file, "w") as f:
            json.dump(pi_data, f, indent=2)
        
        duration = (datetime.now() - start_time).total_seconds()
        self.logger.log_scrape_complete("nih", len(pi_data), duration)
    
    def _consolidate_leads(self):
        """Consolidate leads from all sources"""
        source_files = [
            "data/lead_gen/clinicaltrials_raw.json",
            "data/lead_gen/nih_raw.json"
        ]
        
        # Filter existing files
        existing_files = [f for f in source_files if os.path.exists(f)]
        
        if not existing_files:
            self.logger.log_error("consolidation_error", "No source files found")
            return
        
        df = self.consolidator.consolidate_leads(existing_files)
        
        # Save consolidated results
        output_file = "data/lead_gen/master_leads.csv"
        df.to_csv(output_file, index=False)
        
        self.logger.log_event("consolidation_complete", {
            "total_leads": len(df),
            "tier1": len(df[df["tier"] == "Tier 1"]),
            "tier2": len(df[df["tier"] == "Tier 2"]),
            "tier3": len(df[df["tier"] == "Tier 3"])
        })
    
    def _send_outreach_emails(self, params: Dict):
        """Send outreach emails"""
        leads_file = "data/lead_gen/master_leads.csv"
        
        if not os.path.exists(leads_file):
            self.logger.log_error("email_error", "Master leads file not found")
            return
        
        import pandas as pd
        leads_df = pd.read_csv(leads_file)
        
        # Send emails by tier
        tiers = params.get("email_tiers", ["Tier 1"])
        
        for tier in tiers:
            template_type = tier.lower().replace(" ", "")
            sent_emails, failed_emails = self.email_sender.send_tier_emails(
                leads_df, tier, template_type
            )
            
            self.logger.log_event("emails_sent", {
                "tier": tier,
                "sent": len(sent_emails),
                "failed": len(failed_emails)
            })

def main():
    """Main function"""
    parser = argparse.ArgumentParser(description="Lead Generation Pipeline")
    parser.add_argument("--config", default="config/leadgen_config.json")
    parser.add_argument("--sources", nargs="+", default=["clinicaltrials", "nih"])
    parser.add_argument("--send-emails", action="store_true")
    parser.add_argument("--email-tiers", nargs="+", default=["Tier 1"])
    
    args = parser.parse_args()
    
    # Create orchestrator
    orchestrator = LeadGenOrchestrator(args.config)
    
    # Run pipeline
    params = {
        "sources": args.sources,
        "send_emails": args.send_emails,
        "email_tiers": args.email_tiers,
        "conditions": ["breast cancer", "lung cancer", "colorectal cancer"],
        "phases": ["Phase 3"],
        "keywords": ["oncology", "cancer", "clinical trial"]
    }
    
    orchestrator.run_full_pipeline(params)

if __name__ == "__main__":
    main()
