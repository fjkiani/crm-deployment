@frappe.whitelist()
def dry_run_collector(collector_type: str, params: dict, limit: int = 10):
    """Dry run collector with limited results"""
    if not frappe.has_role("System Manager"):
        frappe.throw(_("Insufficient permissions"))
    
    # Create temporary job for dry run
    job = frappe.get_doc({
        "doctype": "LeadGen Job",
        "job_type": collector_type,
        "params": frappe.as_json(params),
        "status": "Dry Run",
        "owner": frappe.session.user
    })
    job.insert()
    
    try:
        # Run collector with limit
        params["limit"] = limit
        params["dry_run"] = True
        
        if collector_type == "clinicaltrials":
            from crm.leadgen.collectors.clinicaltrials_collector import collect_trials_dry_run
            results = collect_trials_dry_run(params)
        
        job.status = "Completed"
        job.log = f"Dry run completed: {len(results)} records"
        job.save()
        
        return {
            "status": "success",
            "records": results,
            "count": len(results)
        }
        
    except Exception as e:
        job.status = "Failed"
        job.log = f"Dry run failed: {str(e)}"
        job.save()
        
        return {
            "status": "error",
            "error": str(e)
        }

@frappe.whitelist()
def replay_job(job_name: str):
    """Replay a failed job"""
    if not frappe.has_role("System Manager"):
        frappe.throw(_("Insufficient permissions"))
    
    job = frappe.get_doc("LeadGen Job", job_name)
    
    if job.status != "Failed":
        frappe.throw(_("Can only replay failed jobs"))
    
    # Reset job status
    job.status = "Queued"
    job.started_at = None
    job.ended_at = None
    job.log = "Replayed by admin"
    job.save()
    
    # Re-enqueue job
    frappe.enqueue(
        f"crm.leadgen.collectors.{job.job_type}_collector.run",
        job_name=job.name,
        params=frappe.parse_json(job.params),
        queue="long"
    )
    
    return {"status": "replayed", "job_name": job.name}
