## DocType Patterns

### LeadGen Job DocType
```python
# crm/fcrm/doctype/leadgen_job/leadgen_job.py
import frappe
from frappe.model.document import Document

class LeadGenJob(Document):
    def validate(self):
        self.validate_params()
        self.set_defaults()
    
    def validate_params(self):
        """Validate job parameters based on job_type"""
        if self.job_type == "trials":
            required_fields = ["conditions", "interventions", "phases"]
        elif self.job_type == "nih":
            required_fields = ["keywords", "activity_codes"]
        elif self.job_type == "asco":
            required_fields = ["year", "abstract_types"]
        
        for field in required_fields:
            if not self.params.get(field):
                frappe.throw(f"Missing required parameter: {field}")
    
    def set_defaults(self):
        """Set default values"""
        if not self.status:
            self.status = "Queued"
        if not self.started_at and self.status == "Running":
            self.started_at = frappe.utils.now()
```

### Lead Prospect DocType
```python
# crm/fcrm/doctype/lead_prospect/lead_prospect.py
import frappe
from frappe.model.document import Document

class LeadProspect(Document):
    def before_save(self):
        self.calculate_lead_score()
        self.assign_tier()
    
    def calculate_lead_score(self):
        """Calculate lead score based on multiple factors"""
        score = 0
        
        # Funding amount (0-30 points)
        if self.funding_total:
            score += min(30, self.funding_total / 1000000 * 2)
        
        # H-index (0-25 points)
        if self.h_index:
            score += min(25, self.h_index / 2)
        
        # Recent papers (0-20 points)
        if self.recent_papers:
            score += min(20, len(self.recent_papers.split(',')) * 2)
        
        # Cancer type relevance (0-15 points)
        priority_cancers = ["breast", "lung", "colorectal", "prostate"]
        if any(cancer in self.cancer_type.lower() for cancer in priority_cancers):
            score += 15
        
        # Source quality (0-10 points)
        source_scores = {"trials": 10, "nih": 8, "asco": 6, "manual": 5}
        score += source_scores.get(self.source, 0)
        
        self.lead_score = int(score)
    
    def assign_tier(self):
        """Assign tier based on lead score"""
        if self.lead_score >= 80:
            self.tier = "Tier 1"
        elif self.lead_score >= 60:
            self.tier = "Tier 2"
        else:
            self.tier = "Tier 3"
```

