### Collector Implementation Pattern
```python
# crm/leadgen/collectors/clinicaltrials_collector.py
import frappe
import requests
import json
from datetime import datetime

def run(job_name: str, params: dict):
    """Run ClinicalTrials.gov collector"""
    job = frappe.get_doc("LeadGen Job", job_name)
    
    try:
        job.status = "Running"
        job.started_at = frappe.utils.now()
        job.save()
        
        # Collect data
        trials = collect_trials(params)
        
        # Process and save
        prospects = process_trials(trials)
        save_prospects(prospects)
        
        # Update job
        job.status = "Completed"
        job.ended_at = frappe.utils.now()
        job.log = f"Collected {len(trials)} trials, created {len(prospects)} prospects"
        job.save()
        
    except Exception as e:
        job.status = "Failed"
        job.log = f"Error: {str(e)}"
        job.save()
        frappe.log_error(f"LeadGen Job {job_name} failed: {str(e)}")

def collect_trials(params: dict):
    """Collect trials from ClinicalTrials.gov API"""
    base_url = "https://clinicaltrials.gov/api/v2/studies"
    
    # Build query parameters
    query_params = {
        "query.cond": " OR ".join(params.get("conditions", [])),
        "query.intr": " OR ".join(params.get("interventions", [])),
        "query.phase": " OR ".join(params.get("phases", [])),
        "format": "json",
        "pageSize": params.get("page_size", 100)
    }
    
    trials = []
    page = 1
    
    while True:
        query_params["page"] = page
        response = requests.get(base_url, params=query_params)
        response.raise_for_status()
        
        data = response.json()
        trials.extend(data.get("studies", []))
        
        if len(data.get("studies", [])) < query_params["pageSize"]:
            break
        
        page += 1
    
    return trials
```

## Data Processing Patterns

### Consolidation Pattern
```python
# crm/leadgen/processors/consolidate.py
import frappe
from collections import defaultdict

def consolidate_prospects():
    """Consolidate duplicate prospects"""
    # Get all prospects
    prospects = frappe.get_all("Lead Prospect", fields=["*"])
    
    # Group by email
    email_groups = defaultdict(list)
    for prospect in prospects:
        if prospect.pi_email:
            email_groups[prospect.pi_email].append(prospect)
    
    # Process duplicates
    for email, group in email_groups.items():
        if len(group) > 1:
            merge_prospects(group)

def merge_prospects(prospects):
    """Merge duplicate prospects"""
    # Sort by lead score (highest first)
    prospects.sort(key=lambda x: x.lead_score or 0, reverse=True)
    
    primary = prospects[0]
    duplicates = prospects[1:]
    
    # Merge data
    for duplicate in duplicates:
        # Update primary with missing data
        for field in ["phone", "institution", "h_index", "recent_papers"]:
            if not getattr(primary, field) and getattr(duplicate, field):
                setattr(primary, field, getattr(duplicate, field))
        
        # Add source references
        if duplicate.source_ref_id:
            if not primary.source_ref_id:
                primary.source_ref_id = duplicate.source_ref_id
            else:
                primary.source_ref_id += f", {duplicate.source_ref_id}"
        
        # Delete duplicate
        frappe.delete_doc("Lead Prospect", duplicate.name)
    
    primary.save()
```

