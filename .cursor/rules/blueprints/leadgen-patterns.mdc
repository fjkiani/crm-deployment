        total_prospects = frappe.db.count("Lead Prospect")
        
        # Prospects by tier
        tier_counts = frappe.db.sql("""
            SELECT tier, COUNT(*) as count
            FROM `tabLead Prospect`
            GROUP BY tier
        """, as_dict=True)
        
        # Jobs status
        job_status = frappe.db.sql("""
            SELECT status, COUNT(*) as count
            FROM `tabLeadGen Job`
            WHERE creation >= DATE_SUB(NOW(), INTERVAL 7 DAY)
            GROUP BY status
        """, as_dict=True)
        
        return {
            "total_prospects": total_prospects,
            "tier_counts": {t["tier"]: t["count"] for t in tier_counts},
            "job_status": {j["status"]: j["count"] for j in job_status}
        }
