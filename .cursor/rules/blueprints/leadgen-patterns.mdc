```python
# crm/leadgen/outreach/compliance.py
import frappe
from typing import Dict, Any

class EmailCompliance:
    """Email compliance and deliverability management"""
    
    def __init__(self):
        self.settings = frappe.get_doc("LeadGen Email Settings")
    
    def add_unsubscribe_link(self, email_body: str, prospect_email: str) -> str:
        """Add unsubscribe link to email body"""
        unsubscribe_url = f"{self.settings.unsubscribe_link}?email={prospect_email}"
        
        unsubscribe_html = f"""
        <div style="margin-top: 20px; padding: 10px; border-top: 1px solid #ccc; font-size: 12px; color: #666;">
            <p>You received this email because you are a Principal Investigator in oncology clinical trials.</p>
            <p>If you no longer wish to receive these emails, you can <a href="{unsubscribe_url}">unsubscribe here</a>.</p>
        </div>
        """
        
        return email_body + unsubscribe_html
    
    def validate_email_content(self, subject: str, body: str) -> Dict[str, Any]:
        """Validate email content for compliance"""
        issues = []
        
        # Check subject line
        if not subject or len(subject) > 78:
            issues.append("Subject line too long or empty")
        
        # Check for spam keywords
        spam_keywords = ["free", "urgent", "act now", "limited time", "guaranteed"]
        if any(keyword in subject.lower() for keyword in spam_keywords):
            issues.append("Subject contains potential spam keywords")
        
        # Check body length
        if len(body) < 50:
            issues.append("Email body too short")
        
        # Check for unsubscribe link
        if "unsubscribe" not in body.lower():
            issues.append("Missing unsubscribe link")
        
        return {
            "valid": len(issues) == 0,
            "issues": issues
        }
    
    def check_deliverability(self, recipient_email: str) -> Dict[str, Any]:
        """Check email deliverability"""
