### Collector API Pattern
```python
# crm/api/leadgen.py
import frappe
from frappe import _
from frappe.utils import now

@frappe.whitelist()
def run_job(job_type: str, params: dict):
    """Run a lead generation job"""
    # Validate job type
    valid_types = ["trials", "nih", "asco", "consolidate"]
    if job_type not in valid_types:
        frappe.throw(_("Invalid job type"))
    
    # Create job record
    job = frappe.get_doc({
        "doctype": "LeadGen Job",
        "job_type": job_type,
        "params": frappe.as_json(params),
        "status": "Queued"
    })
    job.insert()
    
    # Enqueue job
    frappe.enqueue(
        f"crm.leadgen.collectors.{job_type}_collector.run",
        job_name=job.name,
        params=params,
        queue="long"
    )
    
    return {"job_name": job.name, "status": "Queued"}

@frappe.whitelist()
def job_status(job_name: str):
    """Get job status and logs"""
    job = frappe.get_doc("LeadGen Job", job_name)
    return {
        "status": job.status,
        "started_at": job.started_at,
        "ended_at": job.ended_at,
        "log": job.log,
        "result_file": job.result_file
    }
