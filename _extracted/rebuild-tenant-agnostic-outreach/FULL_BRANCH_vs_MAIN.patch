+# ── ICP / scoring (verbatim from lead_scoring_tool.SCORING_PROMPT_TEMPLATE) ───
+icp_criteria:
+  - "Quantitative or systematic investment firms"
+  - "AUM > $500M"
+  - "Active in biotech/healthcare equities or alternative data"
+  - "Decision-makers: PMs, CIOs, Research Directors"
+# Additive rubric (consolidated from the pipeline score_node — the richer of the
