+# ─────────────────────────────────────────────────────────────────────────────
+# TENANT PACK: Acme Logistics (DUMMY tenant for leakage testing)
+#
+# A deliberately different domain (B2B logistics SaaS) used to prove the outreach
+# engine is tenant-agnostic: rendering with this pack must produce Acme's identity
+# with ZERO leakage of CrisPRO/Zeta/genomic/PARP/KELIM strings.
+# ─────────────────────────────────────────────────────────────────────────────
+
+tenant_id: acme
+
+company_name: "Acme Freight"
+company_description: "a real-time freight visibility platform"
